{
  "name": "kitsune-repo-pet",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "dashboard",
    "extension"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:dashboard": "npm run dev --workspace dashboard",
    "build:extension": "npm run build --workspace extension",
    "build:extension:live": "npm run build:live --workspace extension",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
