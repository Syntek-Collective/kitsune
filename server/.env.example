# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000

# PostgreSQL connection string (CHA-6). Ask a teammate for the value.
DATABASE_URL=

# Used to sign login tokens (CHA-10). Any long random string.
JWT_SECRET=

# The server's public address, used to build each repo's webhook URL.
# Locally: http://localhost:3000 (GitHub can't reach this; real webhooks need the deployed URL)
PUBLIC_URL=http://localhost:3000

# How many proxies sit in front of the server, so the login rate limit sees each visitor's
# real IP. Leave unset to use 1 in production (Render) and none locally. Also accepts
# true/false or comma-separated proxy addresses.
TRUST_PROXY=
